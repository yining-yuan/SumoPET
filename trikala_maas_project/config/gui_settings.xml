<viewsettings>
    <scheme name="real world"/>
	
    <delay value="100"/>
    <viewport zoom="250" x="0" y="0"/>
    
    <!-- PERSONS - ALWAYS VISIBLE, COLOR BY THEIR ID -->
    <person>
        <person-show value="true"/>
        <person-size value="12.0"/>
        <person-shape value="pedestrian"/>
        <person-name-show value="true"/>
        <person-name-size value="60.0"/>
        <person-color value="given"/>
    </person>
    
    <!-- VEHICLES - Smaller so you see people better -->
    <vehicle>
        <vehicle-show value="true"/>
        <vehicle-size value="2.0"/>
        <vehicle-quality value="2"/>
        <vehicle-name-show value="false"/>
    </vehicle>
    
    <!-- BACKGROUND -->
    <background backgroundColor="0.9,0.9,0.9"/>
    <!-- TAZ ZONES - Add this -->
    <taz fill="1" color="0.7,0.7,1.0,0.3"/>
    
    <!-- LEGEND - Shows what colors mean -->
    <legend show-vehicle-colorlegend="true" show-size-legend="true"/>
    
    <!-- STREETS - Make network visible -->
    <edges>
        <edge-name-show value="false"/>
        <street-name-show value="false"/>
    </edges>
</viewsettings>
