<?xml version="1.0" encoding="UTF-8"?>
<configuration>
<input>
  <net-file value="../network/trikala_center_sidewalks.net.xml"/>
  <additional-files value="../network/vehicles_complete.add.xml,../network/infrastructure.add.xml,../network/trikala_zones.taz.xml"/>
  <route-files value="../routes/public_transport.rou.xml,../routes/persons_merged.rou.xml"/>
</input>

<time>
  <begin value="0"/>
  <end value="7200"/>
</time>

<processing>
  <ignore-route-errors value="true"/>
  <persontrip.transfer.car-walk value="parkingAreas"/>
  <persontrip.walkfactor value="0.75"/>
</processing>

<output>
  <tripinfo-output value="../experiments/results/tripinfo_merged.xml"/>
  <summary-output value="../experiments/results/summary.xml"/>
  <emission-output value="../experiments/results/emission.xml"/>
  <fcd-output value="../experiments/results/fcd.xml"/>
  <duration-log.statistics value="true"/>
</output>

<gui_only>
  <gui-settings-file value="gui_settings.xml"/>
  <start value="true"/>
  <quit-on-end value="false"/>
  <delay value="50"/>
</gui_only>

</configuration>